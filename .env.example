# NRW Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า

# Database
NRW_DB_USER=nrw_user
NRW_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
NRW_DB_NAME=nrw_db
DATABASE_URL=postgresql://nrw_user:CHANGE_ME@localhost/nrw_db

# Secret key สำหรับ session/JWT (ใช้: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET

# IoT API Key (ใช้: openssl rand -hex 16)
IOT_API_KEY=CHANGE_ME_TO_IOT_API_KEY

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_ADMIN_PASSWORD

# Server
HOST=0.0.0.0
PORT=8000

# AI Agent (ศูนย์ AI → 🛠️ AI Agent) — เฉพาะเจ้าของ · ตั้งรหัสด้วย: python set_agent_password.py
# AGENT_PASSWORD_HASH=                 (สคริปต์เขียนให้เอง — ไม่ตั้ง = ปิดใช้งาน)
# AGENT_OWNER=admin                    (ใส่ = ใช้ได้เฉพาะบัญชีนี้คนเดียว แม้เป็นผู้ดูแลคนอื่นก็เข้าไม่ได้)
# AGENT_TMUX_TARGET=hermes             (ชื่อ tmux session ที่รัน Hermes)
# AGENT_MODELS=9arm Gateway=/model 9arm;Coder 30B=/model qwen3-coder:30b;Coder 3B=/model qwen2.5-coder:3b
# AGENT_STOP=C-c                       (C-c = กด Ctrl+C หรือใส่ข้อความ เช่น /stop)
# AGENT_RESET=/new                     (หรือ /reset)
# AGENT_SESSION_MIN=120                (ปลดล็อกแล้วใช้ได้กี่นาที)
